<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin • Reports</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-slate-900 text-slate-100 antialiased flex">
    <div id="sidebar"></div>
    <main class="flex-1 min-w-0">
        <header class="border-b border-slate-800/60 px-4 py-3 flex items-center justify-between">
            <h1 class="text-lg font-semibold">System Reports</h1>
            <a class="text-sm text-brand-400 hover:text-brand-300" href="../dashboard.html">← Back to App</a>
        </header>
        <section class="p-4">
            <!-- Generate Report Form -->
            <div class="bg-slate-800/60 rounded-lg border border-slate-700/50 p-6 mb-6">
                <h2 class="text-lg font-semibold mb-4">Generate New Report</h2>
                <form id="generateReportForm" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label for="report_type" class="block text-sm font-medium text-slate-300 mb-2">Report Type
                                *</label>
                            <select id="report_type" name="report_type" required
                                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
                                <option value="">Select report type</option>
                                <option value="most_watched">Most Watched Movies</option>
                                <option value="highest_rated">Highest Rated Movies</option>
                                <option value="most_active_users">Most Active Users</option>
                            </select>
                        </div>
                        <div>
                            <label for="date_range_start" class="block text-sm font-medium text-slate-300 mb-2">Start
                                Date *</label>
                            <input type="date" id="date_range_start" name="date_range_start" required
                                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
                        </div>
                        <div>
                            <label for="date_range_end" class="block text-sm font-medium text-slate-300 mb-2">End Date
                                *</label>
                            <input type="date" id="date_range_end" name="date_range_end" required
                                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm">
                        </div>
                    </div>
                    <div class="flex justify-end">
                        <button type="submit"
                            class="px-6 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded transition duration-200">
                            Generate Report
                        </button>
                    </div>
                </form>
            </div>

            <!-- Past Reports -->
            <div class="bg-slate-800/60 rounded-lg border border-slate-700/50 overflow-hidden">
                <div class="p-4 border-b border-slate-700/50 flex justify-between items-center">
                    <h2 class="text-lg font-semibold">Past Reports</h2>
                    <button id="refreshBtn"
                        class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition duration-200">
                        Refresh
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-slate-400 border-b border-slate-700">
                            <tr>
                                <th class="text-left py-2 px-2">Report ID</th>
                                <th class="text-left py-2 px-2">Report Type</th>
                                <th class="text-left py-2 px-2">Date Range</th>
                                <th class="text-left py-2 px-2">Generated By</th>
                                <th class="text-left py-2 px-2">Generated Date</th>
                                <th class="text-left py-2 px-2">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reportsTableBody" class="divide-y divide-slate-700"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Report View Modal -->
    <div id="reportModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-slate-800 rounded-lg shadow-xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-hidden flex flex-col">
            <div class="p-6 border-b border-slate-700 flex justify-between items-center">
                <h3 class="text-xl font-semibold" id="modalTitle">Report Details</h3>
                <button data-action="close-modal" class="text-slate-400 hover:text-slate-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1">
                <div id="modalContent" class="text-slate-300"></div>
            </div>
            <div class="p-6 border-t border-slate-700 flex justify-end">
                <button data-action="close-modal"
                    class="px-6 py-2 bg-slate-700 hover:bg-slate-600 rounded transition duration-200">
                    Close
                </button>
            </div>
        </div>
    </div>

    <script>
        (async function () {
            document.getElementById('sidebar').innerHTML = await fetch('../components/admin-sidebar.html').then(r => r.text());

            const tbody = document.getElementById('reportsTableBody');

            async function loadReports() {
                try {
                    tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-slate-400">Loading reports...</td></tr>';

                    const response = await fetch('/api/admin/reports');

                    if (!response.ok) {
                        throw new Error('Failed to load reports');
                    }

                    const reports = await response.json();

                    if (reports.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-slate-500">No reports found. Generate a new one above.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = reports.map(report => `
            <tr class="hover:bg-slate-800/20">
              <td class="py-2 px-2 text-slate-400">#${report.report_id}</td>
              <td class="py-2 px-2">${getReportTypeBadge(report.report_type)}</td>
              <td class="py-2 px-2 text-slate-400">${new Date(report.date_range_start).toLocaleDateString()} - ${new Date(report.date_range_end).toLocaleDateString()}</td>
              <td class="py-2 px-2 text-slate-400">${report.admin_name || 'System'}</td>
              <td class="py-2 px-2 text-slate-400">${new Date(report.generated_date).toLocaleString()}</td>
              <td class="py-2 px-2">
                <button data-action="view" data-report='${JSON.stringify(report).replace(/'/g, "&#39;")}' class="text-brand-400 hover:text-brand-300 text-xs mr-2">View</button>
                <button data-action="delete" data-id="${report.report_id}" class="text-red-400 hover:text-red-300 text-xs">Delete</button>
              </td>
            </tr>
          `).join('');

                } catch (error) {
                    console.error('Error loading reports:', error);
                    tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-red-400">Error loading reports. Please try again.</td></tr>';
                }
            }

            function getReportTypeBadge(type) {
                const badges = {
                    most_watched: '<span class="px-2 py-1 bg-blue-900/30 text-blue-400 rounded text-xs">Most Watched</span>',
                    highest_rated: '<span class="px-2 py-1 bg-purple-900/30 text-purple-400 rounded text-xs">Highest Rated</span>',
                    most_active_users: '<span class="px-2 py-1 bg-green-900/30 text-green-400 rounded text-xs">Active Users</span>',
                };
                return badges[type] || `<span class="px-2 py-1 bg-slate-900/30 text-slate-400 rounded text-xs">${type}</span>`;
            }

            // Event delegation for table buttons
            tbody.addEventListener('click', async (e) => {
                const button = e.target.closest('button[data-action]');
                if (!button) return;

                const action = button.dataset.action;

                if (action === 'view') {
                    const report = JSON.parse(button.dataset.report);
                    viewReport(report);
                } else if (action === 'delete') {
                    const id = button.dataset.id;
                    if (!confirm('Are you sure you want to delete this report?')) return;

                    try {
                        const response = await fetch(`/api/admin/reports/${id}`, { method: 'DELETE' });
                        if (response.ok) {
                            loadReports();
                        } else {
                            alert('Failed to delete report');
                        }
                    } catch (error) {
                        console.error('Error deleting report:', error);
                        alert('Failed to delete report');
                    }
                }
            });

            // Event delegation for modal close buttons
            document.getElementById('reportModal').addEventListener('click', (e) => {
                const button = e.target.closest('button[data-action="close-modal"]');
                if (button || e.target.id === 'reportModal') {
                    document.getElementById('reportModal').classList.add('hidden');
                }
            });

            function viewReport(report) {
                const modal = document.getElementById('reportModal');
                const title = document.getElementById('modalTitle');
                const content = document.getElementById('modalContent');

                title.textContent = `${getReportTypeLabel(report.report_type)} - ${new Date(report.date_range_start).toLocaleDateString()} to ${new Date(report.date_range_end).toLocaleDateString()}`;

                let html = '<div class="space-y-4">';

                if (report.report_data && typeof report.report_data === 'object') {
                    html += '<div class="bg-slate-900/50 p-4 rounded-lg border border-slate-700">';
                    html += '<h4 class="font-semibold text-slate-200 mb-3">Report Summary</h4>';
                    html += renderReportData(report.report_data);
                    html += '</div>';
                } else {
                    html += '<p class="text-slate-500">No data available for this report.</p>';
                }

                html += `<div class="mt-4 text-sm text-slate-400">
          <p><strong>Generated by:</strong> ${report.admin_name || 'System'}</p>
          <p><strong>Generated on:</strong> ${new Date(report.generated_date).toLocaleString()}</p>
        </div>`;
                html += '</div>';

                content.innerHTML = html;
                modal.classList.remove('hidden');
            }

            function renderReportData(data) {
                let html = '';

                for (const [key, value] of Object.entries(data)) {
                    html += '<div class="mb-3">';
                    html += `<div class="font-medium text-slate-300 mb-1">${formatKey(key)}:</div>`;

                    if (Array.isArray(value)) {
                        if (value.length === 0) {
                            html += '<p class="text-slate-500 ml-4">No data</p>';
                        } else if (typeof value[0] === 'object') {
                            html += '<div class="ml-4 overflow-x-auto">';
                            html += '<table class="min-w-full text-sm border border-slate-700">';
                            html += '<thead class="bg-slate-800"><tr>';
                            Object.keys(value[0]).forEach(k => {
                                html += `<th class="px-3 py-2 text-left border-b border-slate-700">${formatKey(k)}</th>`;
                            });
                            html += '</tr></thead><tbody>';
                            value.forEach(item => {
                                html += '<tr>';
                                Object.values(item).forEach(v => {
                                    html += `<td class="px-3 py-2 border-b border-slate-700">${v}</td>`;
                                });
                                html += '</tr>';
                            });
                            html += '</tbody></table></div>';
                        } else {
                            html += '<ul class="ml-4 list-disc list-inside">';
                            value.forEach(item => {
                                html += `<li>${item}</li>`;
                            });
                            html += '</ul>';
                        }
                    } else if (typeof value === 'object' && value !== null) {
                        html += '<div class="ml-4">';
                        html += renderReportData(value);
                        html += '</div>';
                    } else {
                        html += `<p class="ml-4 text-slate-200">${value}</p>`;
                    }

                    html += '</div>';
                }

                return html;
            }

            function formatKey(key) {
                return key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            }

            function getReportTypeLabel(type) {
                const labels = {
                    most_watched: 'Most Watched Movies',
                    highest_rated: 'Highest Rated Movies',
                    most_active_users: 'Most Active Users'
                };
                return labels[type] || type;
            }

            // Generate new report
            document.getElementById('generateReportForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const report_type = document.getElementById('report_type').value;
                const start_date = document.getElementById('date_range_start').value;
                const end_date = document.getElementById('date_range_end').value;

                if (!report_type || !start_date || !end_date) {
                    alert('Please fill in all fields');
                    return;
                }

                try {
                    const response = await fetch('/api/admin/reports', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ report_type, start_date, end_date })
                    });

                    const result = await response.json();

                    if (response.ok) {
                        alert('Report generated successfully!');
                        loadReports();
                    } else {
                        alert(result.error || 'Failed to generate report');
                    }
                } catch (error) {
                    console.error('Error generating report:', error);
                    alert('Failed to generate report');
                }
            });

            // Refresh button
            document.getElementById('refreshBtn').addEventListener('click', loadReports);

            // Set default dates (last 30 days)
            const today = new Date();
            const thirtyDaysAgo = new Date(today);
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

            document.getElementById('date_range_start').value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById('date_range_end').value = today.toISOString().split('T')[0];

            // Initial load
            loadReports();
        })();
    </script>
</body>

</html>